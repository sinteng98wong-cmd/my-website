// ── Stock & DO ───────────────────────────────────────────────────────────

// Hierarchical categories: top-level (parentId = null) then subcategories
model StockCategory {
  id         String          @id @default(cuid())
  name       String
  parentId   String?
  parent     StockCategory?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children   StockCategory[] @relation("CategoryChildren")
  items      StockItem[]
  @@unique([name, parentId])
}

model Supplier {
  id          String         @id @default(cuid())
  name        String
  code        String?        @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  active      Boolean        @default(true)
  items         StockItem[]
  stockInvoices StockInvoice[]
  poolOrders    PoolOrder[]
  batches       StockBatch[]
  payments      SupplierPayment[]
  purchaseOrders PurchaseOrder[]  @relation("POSupplier")
  pvs            PaymentVoucher[]
  registrationNo String?
  bankName       String?
  accountNo      String?
  accountName    String?
  createdAt     DateTime         @default(now())
}

model StockItem {
  id             String         @id @default(cuid())
  sku            String         @unique
  name           String
  category       String         // legacy plain-text, kept for backward compat
  categoryId     String?
  stockCategory  StockCategory? @relation(fields: [categoryId], references: [id])
  supplierId     String?        // preferred / default supplier
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])
  unit           String         @default("unit")
  clinicStock    ClinicStock[]
  doLines        DOLine[]
  poolLines      PoolOrderLine[]
  participantLines PoolParticipantLine[]
  batches        StockBatch[]
  poLines        POLine[]
  movements      StockMovement[]
  stockTakeLines StockTakeLine[]
  issueLines     StockIssueLine[]
}

model ClinicStock {
  id          String    @id @default(cuid())
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  itemId      String
  item        StockItem @relation(fields: [itemId], references: [id])
  quantity    Int       @default(0)
  parLevel    Int       @default(0)
  avgUnitCost Decimal?  @db.Decimal(10,2) // running average cost at this clinic
  updatedAt   DateTime  @updatedAt
  @@unique([clinicId, itemId])
  @@index([clinicId, quantity])
}

// Tracks individual received batches with expiry — used for FIFO and expiry alerts
model StockBatch {
  id          String    @id @default(cuid())
  itemId      String
  item        StockItem @relation(fields: [itemId], references: [id])
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  batchNumber String
  expiryDate  DateTime?
  quantity    Int       // received quantity in this batch
  remainingQty Int      // quantity not yet consumed
  unitCost    Decimal   @db.Decimal(10,2)
  doLineId    String?   // traceability back to the DO line
  receivedAt  DateTime  @default(now())
  movements   StockMovement[]
  issueLines  StockIssueLine[]       @relation("StockIssueLineBatch")
  allocations StockIssueAllocation[] @relation("StockIssueAllocationBatch")
  transfers   DOLineBatch[]          @relation("DOLineBatchSource")
  @@index([clinicId, itemId])
  @@index([expiryDate])
  @@index([clinicId, expiryDate])
}

// ── Stock Ledger ──────────────────────────────────────────────────────────
// The authoritative, immutable history of every stock movement.
//
// Phase 1 (Tier 3A): written alongside ClinicStock, which remains the
// operational balance. The ledger is not yet the reporting source of truth.
//
// Immutability is enforced by database trigger, not only by convention:
// historical rows can never be updated, and corrections must be posted as a
// new compensating movement linked through reversalOfId.

enum StockMovementType {
  OPENING_BALANCE
  RECEIPT_PO
  RECEIPT_FOC             // free goods — quantity in at zero cost
  RECEIPT_POOL
  RETURN_SUPPLIER
  TRANSFER_OUT
  TRANSFER_IN
  TRANSFER_VARIANCE_OUT   // dispatched but never arrived; owned by the receiver
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STOCK_TAKE_IN
  STOCK_TAKE_OUT
  CONSUMPTION
  CONSUMPTION_REVERSAL
  WRITE_OFF_EXPIRY
  WRITE_OFF_DAMAGE
  WRITE_OFF_WASTAGE       // spoiled or unusable without being damaged or expired
  REVALUATION             // value-only movement, zero quantity
}

enum StockDirection {
  IN
  OUT
  NONE
}

enum DriftRunStatus {
  SUCCESS
  FAILED
}

enum DriftRunTrigger {
  CRON
  MANUAL
}

/// Audit record of each stock-ledger drift detection run. Monitoring metadata
/// for Phase 1 dual-write — not part of the ledger itself.
model StockDriftRun {
  id           String          @id @default(cuid())
  trigger      DriftRunTrigger @default(CRON)
  status       DriftRunStatus
  startedAt    DateTime
  finishedAt   DateTime
  durationMs   Int
  positions    Int             @default(0)
  movements    Int             @default(0)
  errorCount   Int             @default(0)
  warningCount Int             @default(0)
  /// Pre-ledger MISSING_MOVEMENTS rows land here. Never treated as a failure.
  infoCount    Int             @default(0)
  clean        Boolean         @default(false)
  /// Errors and warnings only, bounded. Informational rows are counted, not stored.
  findings     Json            @default("[]")
  errorMessage String?
  alertSentAt  DateTime?
  createdAt    DateTime        @default(now())
  @@index([startedAt])
  @@index([status])
}

enum StockSourceType {
  PURCHASE_ORDER
  DELIVERY_ORDER
  POOL_ORDER
  STOCK_ADJUSTMENT
  STOCK_TAKE
  STOCK_ISSUE
  WRITE_OFF
  STOCK_INVOICE
  MIGRATION
}

model StockMovement {
  id            String            @id @default(cuid())
  /// Strict global ordering of postings.
  seq           BigInt            @unique @default(autoincrement())

  clinicId      String
  clinic        Clinic            @relation(fields: [clinicId], references: [id])
  itemId        String
  item          StockItem         @relation(fields: [itemId], references: [id])
  batchId       String?
  batch         StockBatch?       @relation(fields: [batchId], references: [id])

  type          StockMovementType
  direction     StockDirection

  qtyIn         Int               @default(0)
  qtyOut        Int               @default(0)
  unitCost      Decimal           @db.Decimal(12,4)
  /// Unsigned value of this movement, for display.
  totalCost     Decimal           @db.Decimal(14,2)
  /// Signed value impact — the column stock valuation will sum.
  valueDelta    Decimal           @db.Decimal(14,2)

  /// Quantity balance immediately after this movement, captured under the
  /// same row lock that performed the mutation.
  balanceAfter  Int
  valueAfter    Decimal           @db.Decimal(14,2)
  avgCostAfter  Decimal           @db.Decimal(12,4)

  sourceType    StockSourceType
  sourceId      String?
  sourceLineId  String?
  reference     String
  /// Deterministic idempotency key — replaying a posting collides here
  /// instead of double-posting the goods.
  postingKey    String            @unique

  reversalOfId  String?
  reversalOf    StockMovement?    @relation("StockMovementReversal", fields: [reversalOfId], references: [id])
  reversedBy    StockMovement[]   @relation("StockMovementReversal")

  note          String?
  movementAt    DateTime          @default(now())
  period        String            // "2026-08"
  createdById   String?
  createdBy     User?             @relation("StockMovementCreator", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([clinicId, itemId, seq])
  @@index([clinicId, period])
  @@index([itemId, seq])
  @@index([batchId])
  @@index([sourceType, sourceId])
  @@index([type])
  @@index([reversalOfId])
}

// ── Stock Take & Adjustment ───────────────────────────────────────────────
// Operational physical counting. A count records the system quantity at the
// time it is raised, staff enter what they physically find, and only PIC
// approval turns the variance into adjustment movements in the ledger.
//
// Nothing here writes ClinicStock directly — approval goes through the same
// atomic mutation path every other stock movement uses.

enum StockTakeStatus {
  DRAFT
  SUBMITTED
  RECOUNT_REQUIRED   // stock moved since the count; must be re-counted
  APPROVED
  REJECTED
}

enum StockAdjustmentReason {
  STOCK_COUNT_VARIANCE
  DAMAGED
  EXPIRED
  WASTAGE
  FOUND_STOCK
  DATA_CORRECTION
  OTHER
}

model StockTake {
  id            String          @id @default(cuid())
  reference     String          @unique          // STK-202608-001
  clinicId      String
  clinic        Clinic          @relation(fields: [clinicId], references: [id])
  status        StockTakeStatus @default(DRAFT)
  notes         String?

  createdById   String
  createdBy     User            @relation("StockTakeCreator", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  submittedById String?
  submittedBy   User?           @relation("StockTakeSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime?
  reviewedById  String?
  reviewedBy    User?           @relation("StockTakeReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?
  postedAt      DateTime?

  totalVarianceQty   Int        @default(0)
  totalVarianceValue Decimal    @default(0) @db.Decimal(14,2)

  lines         StockTakeLine[]
  updatedAt     DateTime        @updatedAt
  @@index([clinicId, status])
  @@index([createdAt])
}

model StockTakeLine {
  id           String                 @id @default(cuid())
  stockTakeId  String
  stockTake    StockTake              @relation(fields: [stockTakeId], references: [id])
  itemId       String
  item         StockItem              @relation(fields: [itemId], references: [id])

  /// System quantity when the count was raised, refreshed on a recount.
  systemQty    Int
  physicalQty  Int?
  /// Average cost snapshot, for the estimated variance value before posting.
  avgUnitCost  Decimal                @db.Decimal(12,4)
  reason       StockAdjustmentReason?
  note         String?
  countedById  String?
  countedBy    User?                  @relation("StockTakeCounter", fields: [countedById], references: [id])
  countedAt    DateTime?

  /// Frozen at approval — what was actually posted.
  postedVarianceQty Int?
  postedUnitCost    Decimal?          @db.Decimal(12,4)
  movementId        String?

  @@unique([stockTakeId, itemId])
  @@index([stockTakeId])
}

// ── Stock Issue / Consumption ─────────────────────────────────────────────
// The normal stock-out path: clinical consumption, general usage, and
// expiry/damage/wastage write-offs. Everything posts through the same atomic
// mutation helpers and the same immutable ledger as receipts and transfers.
//
// FEFO decides which physical batch is depleted; weighted average still
// decides the money. The two are independent.

enum StockIssueReason {
  CLINICAL_CONSUMPTION
  GENERAL_USAGE
  DAMAGED
  WASTAGE
  EXPIRED
  OTHER
}

enum StockIssueStatus {
  DRAFT
  PENDING_APPROVAL   // write-offs await PIC sign-off
  POSTED
  REJECTED
}

/// Where the issue originated. MANUAL today; VISIT/TREATMENT let a future
/// clinical flow reference this same mechanism without reshaping it.
enum StockIssueSource {
  MANUAL
  VISIT
  TREATMENT
}

model StockIssue {
  id            String            @id @default(cuid())
  reference     String            @unique          // ISS-202608-001
  clinicId      String
  clinic        Clinic            @relation(fields: [clinicId], references: [id])
  status        StockIssueStatus  @default(DRAFT)
  reason        StockIssueReason
  notes         String?

  /// Extensible origin — a future Visit/Treatment issues stock through here.
  sourceKind    StockIssueSource  @default(MANUAL)
  sourceRefId   String?

  createdById   String
  createdBy     User              @relation("StockIssueCreator", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  submittedById String?
  submittedBy   User?             @relation("StockIssueSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime?
  reviewedById  String?
  reviewedBy    User?             @relation("StockIssueReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?
  postedAt      DateTime?

  totalQty      Int               @default(0)
  totalValue    Decimal           @default(0) @db.Decimal(14,2)

  lines         StockIssueLine[]
  updatedAt     DateTime          @updatedAt
  @@index([clinicId, status])
  @@index([createdAt])
  @@index([sourceKind, sourceRefId])
}

model StockIssueLine {
  id           String                 @id @default(cuid())
  stockIssueId String
  stockIssue   StockIssue             @relation(fields: [stockIssueId], references: [id])
  itemId       String
  item         StockItem              @relation(fields: [itemId], references: [id])
  quantity     Int
  /// Pin the issue to one batch (used by expiry write-offs). Null = FEFO.
  batchId      String?
  batch        StockBatch?            @relation("StockIssueLineBatch", fields: [batchId], references: [id])
  note         String?

  /// Frozen at posting.
  unitCost     Decimal?               @db.Decimal(12,4)
  movementId   String?

  allocations  StockIssueAllocation[]
  @@index([stockIssueId])
  @@index([itemId])
}

/// What was physically taken, batch by batch. A null batch is an explicit
/// unbatched allocation — stock on hand with no batch record behind it — kept
/// distinguishable from real batch stock rather than silently merged.
model StockIssueAllocation {
  id           String         @id @default(cuid())
  lineId       String
  line         StockIssueLine @relation(fields: [lineId], references: [id])
  batchId      String?
  batch        StockBatch?    @relation("StockIssueAllocationBatch", fields: [batchId], references: [id])
  batchNumber  String?
  expiryDate   DateTime?
  quantity     Int
  createdAt    DateTime       @default(now())
  @@index([lineId])
  @@index([batchId])
}

// Tracks payments made to a supplier (against their stock invoices)
model SupplierPayment {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  amount      Decimal  @db.Decimal(10,2)
  paidAt      DateTime @default(now())
  reference   String?  // cheque no., bank transfer ref, etc.
  notes       String?
  recordedBy  String?  // userId
  createdAt   DateTime @default(now())
  @@index([supplierId, paidAt])
}

enum DOStatus {
  DRAFT
  PENDING
  APPROVED
  IN_TRANSIT
  RECEIVED
  INVOICED
}

model DeliveryOrder {
  id             String        @id @default(cuid())
  doRef          String        @unique
  fromClinicId   String
  fromClinic     Clinic        @relation("DispatchingClinic", fields: [fromClinicId], references: [id])
  toClinicId     String
  toClinic       Clinic        @relation("ReceivingClinic", fields: [toClinicId], references: [id])
  status         DOStatus      @default(DRAFT)
  notes          String?
  poolOrderId    String?
  poolOrder      PoolOrder?    @relation(fields: [poolOrderId], references: [id])
  stockInvoiceId String?
  stockInvoice   StockInvoice? @relation(fields: [stockInvoiceId], references: [id])
  raisedById     String?
  raisedBy       User?         @relation("DORaisedBy", fields: [raisedById], references: [id])
  approvedById   String?
  approvedBy     User?         @relation("DOApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  lines          DOLine[]
  raisedAt       DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([fromClinicId, status])
  @@index([toClinicId, status])
  @@index([poolOrderId])
}

model DOLine {
  id          String        @id @default(cuid())
  doId        String
  do          DeliveryOrder @relation(fields: [doId], references: [id])
  itemId      String
  item        StockItem     @relation(fields: [itemId], references: [id])
  quantity    Int
  receivedQty Int?
  unitCost    Decimal       @db.Decimal(10,2)
  batchNumber String?       // batch number assigned on receipt
  expiryDate  DateTime?     // expiry date assigned on receipt
  notes       String?
  /// Which physical batches this line took at dispatch, so the receiving
  /// clinic recreates the same identities instead of minting new ones.
  batchAllocations DOLineBatch[]
  @@index([doId])
}

/// A physical batch carried by one delivery order line.
///
/// Written at dispatch from what the source clinic actually depleted, and read
/// at receipt to recreate the same batch identity at the destination. Without
/// it a transfer would create destination batch quantity out of nothing while
/// the source batch stayed full.
model DOLineBatch {
  id            String      @id @default(cuid())
  doLineId      String
  doLine        DOLine      @relation(fields: [doLineId], references: [id])
  /// Batch depleted at source. Null when the source stock was unbatched.
  sourceBatchId String?
  sourceBatch   StockBatch? @relation("DOLineBatchSource", fields: [sourceBatchId], references: [id])
  /// Identity to recreate at the destination. Null = unbatched, not invented.
  batchNumber   String?
  expiryDate    DateTime?
  quantity      Int
  createdAt     DateTime    @default(now())
  @@index([doLineId])
  @@index([sourceBatchId])
}

enum InvoiceSource {
  INTERNAL    // from DO (inter-clinic transfer)
  SUPPLIER    // from Purchase Order or Pool Order
}

model StockInvoice {
  id              String          @id @default(cuid())
  invoiceRef      String          @unique
  source          InvoiceSource   @default(INTERNAL)
  fromEntityId    String
  fromEntity      Entity          @relation(fields: [fromEntityId], references: [id])
  supplierId      String?
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  /// Unique: a purchase order carries at most one supplier invoice. Postgres
  /// allows many NULLs, so internal (DO-based) invoices are unaffected. This is
  /// the database-level backstop against revaluing the same receipt twice.
  purchaseOrderId String?         @unique
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  month           String
  totalAmount     Decimal         @db.Decimal(10,2)
  sst             Decimal         @default(0) @db.Decimal(10,2)
  eInvoiceRef     String?
  deliveryOrders     DeliveryOrder[]
  pvSupplierInvoices SupplierInvoice[]
  issuedAt        DateTime?
  createdAt       DateTime        @default(now())
  @@index([month])
  @@index([supplierId])
}

// ── Pool Orders ──────────────────────────────────────────────────────────

enum PoolDeliveryMode {
  CENTRALISED
  DIRECT
}

enum PoolStatus {
  OPEN
  CLOSED
  REOPENED
  SUBMITTED
  DELIVERED
  DISTRIBUTED
  INVOICED
}

model PoolOrder {
  id                 String            @id @default(cuid())
  poRef              String            @unique
  initiatingClinicId String
  initiatingClinic   Clinic            @relation("InitiatingClinic", fields: [initiatingClinicId], references: [id])
  supplierName       String            // kept for legacy; prefer supplierId
  supplierId         String?
  supplier           Supplier?         @relation(fields: [supplierId], references: [id])
  deliveryMode       PoolDeliveryMode  @default(CENTRALISED)
  moqTarget          Decimal           @db.Decimal(10,2)
  status             PoolStatus        @default(OPEN)
  deadline           DateTime?
  deadlineNotifiedAt DateTime?
  notes              String?
  raisedById         String?
  raisedBy           User?             @relation("PoolOrderRaisedBy", fields: [raisedById], references: [id])
  approvedById       String?
  approvedBy         User?             @relation("PoolOrderApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  deliveredAt        DateTime?
  reopenedAt         DateTime?
  reopenedById       String?
  reopenedBy         User?             @relation("PoolOrderReopenedBy", fields: [reopenedById], references: [id])
  lines              PoolOrderLine[]
  participants       PoolParticipant[]
  deliveryOrders     DeliveryOrder[]
  pvSupplierInvoices SupplierInvoice[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status])
  @@index([initiatingClinicId])
}

model PoolOrderLine {
  id             String    @id @default(cuid())
  poolId         String
  pool           PoolOrder @relation(fields: [poolId], references: [id])
  itemId         String
  item           StockItem @relation(fields: [itemId], references: [id])
  totalQty       Int
  unitCost       Decimal   @db.Decimal(10,2)   // estimated cost at order time
  actualUnitCost Decimal?  @db.Decimal(10,2)   // = totalInvoiced / totalReceivedQty (set when invoiced)
  totalReceived  Int?                           // includes free goods (buy 10 free 2 → 12)
  @@index([poolId])
}

model PoolParticipant {
  id              String                @id @default(cuid())
  poolId          String
  pool            PoolOrder             @relation(fields: [poolId], references: [id])
  clinicId        String
  clinic          Clinic                @relation(fields: [clinicId], references: [id])
  requestedAmount Decimal               @db.Decimal(10,2)
  receivedAt      DateTime?
  joinedAt        DateTime              @default(now())
  joinedById      String?
  joinedBy        User?                 @relation("PoolParticipantJoinedBy", fields: [joinedById], references: [id])
  items           PoolParticipantLine[]
  @@unique([poolId, clinicId])
  @@index([poolId])
}

model PoolParticipantLine {
  id              String          @id @default(cuid())
  participantId   String
  participant     PoolParticipant @relation(fields: [participantId], references: [id])
  itemId          String
  item            StockItem       @relation(fields: [itemId], references: [id])
  requestedQty    Int
  approvedQty     Int?
  unitCost        Decimal         @db.Decimal(10,2)
  @@index([participantId])
  @@index([itemId])
}

// ── Purchase Orders (from external suppliers) ────────────────────────────

enum POStatus {
  DRAFT
  SUBMITTED    // sent to supplier
  CONFIRMED    // supplier acknowledged
  PARTIAL      // partially received
  RECEIVED     // fully received
  INVOICED     // supplier invoice linked
  CANCELLED
}

model PurchaseOrder {
  id            String          @id @default(cuid())
  poRef         String          @unique
  clinicId      String                         // receiving clinic (usually HQ)
  clinic        Clinic          @relation("POReceivingClinic", fields: [clinicId], references: [id])
  supplierId    String
  supplier      Supplier        @relation("POSupplier", fields: [supplierId], references: [id])
  status        POStatus        @default(DRAFT)
  expectedDate  DateTime?
  notes         String?
  raisedById    String?
  raisedBy      User?           @relation("PORaisedBy", fields: [raisedById], references: [id])
  confirmedAt   DateTime?
  receivedAt    DateTime?
  lines         POLine[]
  stockInvoice  StockInvoice?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  @@index([supplierId, status])
  @@index([clinicId, status])
}

model POLine {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id])
  itemId      String
  item        StockItem     @relation(fields: [itemId], references: [id])
  quantity    Int
  receivedQty Int?
  /// Quantity already posted into ClinicStock. Receipts post only the
  /// difference against this baseline, so re-running a receipt is a no-op and
  /// receiving the remainder after a PARTIAL never re-posts earlier goods.
  postedQty   Int           @default(0)
  unitCost    Decimal       @db.Decimal(10,2)
  batchNumber String?
  expiryDate  DateTime?
  notes       String?
  @@index([poId])
}

// ── Daily Ledger ────────────────────────────────────────────────────────

model DailyLedger {
  id               String    @id @default(cuid())
  clinicId         String
  clinic           Clinic    @relation(fields: [clinicId], references: [id])
  date             DateTime
  patientCount     Int
  professionalFee  Decimal   @db.Decimal(10,2)
  productSales     Decimal   @default(0) @db.Decimal(10,2)
  sst              Decimal   @default(0) @db.Decimal(10,2)
  totalSales       Decimal   @db.Decimal(10,2)
  cashCurrent      Decimal   @default(0) @db.Decimal(10,2)
  cashNext         Decimal   @default(0) @db.Decimal(10,2)
  creditCard       Decimal   @default(0) @db.Decimal(10,2)
  fpx              Decimal   @default(0) @db.Decimal(10,2)
  ewallet          Decimal   @default(0) @db.Decimal(10,2)
  atome            Decimal   @default(0) @db.Decimal(10,2)
  panelCollections Json      @default("{}")
  depositTopup     Decimal   @default(0) @db.Decimal(10,2)
  depositRefund    Decimal   @default(0) @db.Decimal(10,2)
  salesReturn      Decimal   @default(0) @db.Decimal(10,2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  updatedBy        String?
  updatedByUser    User?     @relation(fields: [updatedBy], references: [id])
  @@unique([clinicId, date])
  @@index([date])
}

// ── Appointments ─────────────────────────────────────────────────────────

enum AppointmentType {
  CHECKUP
  CONSULTATION
  TREATMENT
  FOLLOWUP
  CLEANING
  EXTRACTION
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id             String            @id @default(cuid())
  apptRef        String            @unique
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id])
  clinicId       String
  clinic         Clinic            @relation(fields: [clinicId], references: [id])
  doctorId       String
  doctor         User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  startTime      DateTime          // full date+time in UTC; no separate date field
  duration       Int               @default(30)
  type           AppointmentType   @default(CHECKUP)
  chiefComplaint String?
  notes          String?
  status         AppointmentStatus @default(SCHEDULED)
  visitId        String?           @unique
  visit          Visit?            @relation(fields: [visitId], references: [id])
  createdAt      DateTime          @default(now())
  @@index([clinicId, startTime])
  @@index([doctorId, startTime])
  @@index([patientId])
  @@index([status])
}

// ── Cash Banking ─────────────────────────────────────────────────────────

model CashBanking {
  id            String    @id @default(cuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  periodFrom    DateTime
  periodTo      DateTime
  expectedCash  Decimal   @db.Decimal(10,2)
  bankInAmount  Decimal   @db.Decimal(10,2)
  variance      Decimal   @default(0) @db.Decimal(10,2)
  bankInDate    DateTime
  // ONLINE_TRANSFER | CASH_DEPOSIT_MACHINE
  depositType   String    @default("ONLINE_TRANSFER")
  referenceNo   String?
  notes         String?
  recordedById  String?
  createdAt     DateTime  @default(now())
  @@index([clinicId, bankInDate])
}

// ── Schedule ────────────────────────────────────────────────────────────

model Schedule {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  doctorId        String
  doctor          User     @relation("DoctorSchedule",       fields: [doctorId],       references: [id])
  nurseId         String?
  nurse           User?    @relation("NurseSchedule",        fields: [nurseId],        references: [id])
  receptionistId  String?
  receptionist    User?    @relation("ReceptionistSchedule", fields: [receptionistId], references: [id])
  date            DateTime
  startTime       DateTime
  endTime         DateTime
  notes           String?
  createdAt       DateTime @default(now())
  @@unique([clinicId, doctorId, startTime])
  @@index([clinicId, date])
  @@index([doctorId, date])
}

// StaffLeave, LeaveType, LeaveStatus removed — migrated to LeaveApplication / HrLeaveType / HrLeaveStatus

// ── Ledger Account Codes ─────────────────────────────────────────────────

model LedgerAccountCode {
  id          String  @id @default(cuid())
  clinicId    String?
  clinic      Clinic? @relation(fields: [clinicId], references: [id])
  entryType   String
  accountCode String
  subCode     String?
  description String
  module      String
  sortOrder   Int     @default(0)
  @@unique([clinicId, entryType])
}

// ── Role Access Config ───────────────────────────────────────────────────

model RoleModuleConfig {
  id        String   @id @default(cuid())
  role      String
  module    String
  enabled   Boolean  @default(true)
  actions   String   @default("[]") // JSON: ["view","create","edit","delete","export","approve"]
  updatedAt DateTime @updatedAt
  updatedBy String?
  @@unique([role, module])
}

// ── Per-user per-clinic module override ──────────────────────────────────

model UserClinicModule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  module    String
  actions   String   // JSON: ["view","create","edit",...] — overrides role default for this user+clinic
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, clinicId, module])
  @@index([userId, clinicId])
}

model RoleClinicConfig {
  id        String   @id @default(cuid())
  role      String
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  @@unique([role, clinicId])
}

// ── Dental Chart ─────────────────────────────────────────────────────────

model ToothRecord {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  visitId     String?
  visit       Visit?   @relation(fields: [visitId], references: [id])
  toothCode   String
  condition   String   @default("healthy")
  surfaces    String?
  notes       String?
  recordedAt  DateTime @default(now())
  recordedBy  String?
  @@index([patientId, toothCode])
  @@index([patientId])
  @@index([visitId])
}

// ── Medical Certificate ───────────────────────────────────────────────────

model MedicalCertificate {
  id          String   @id @default(cuid())
  mcRef       String   @unique
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  visitId     String?
  issuedById  String
  issuedBy    User     @relation(fields: [issuedById], references: [id])
  issueDate   DateTime
  fromDate    DateTime
  toDate      DateTime
  days        Int
  diagnosis   String?
  remarks     String?
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  createdAt   DateTime @default(now())
}

// ════════════════════════════════════════════════════════════════════════
// HRMS MODULE
// ════════════════════════════════════════════════════════════════════════

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  LOCUM
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  SUSPENDED
  RESIGNED
  TERMINATED
  RETIRED
}

enum HrLeaveType {
  ANNUAL
  MEDICAL
  EMERGENCY
  MATERNITY
  PATERNITY
  UNPAID
  REPLACEMENT
  HOSPITALISATION
  COMPASSIONATE
}

enum HrLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
  FULL_DAY
  CUSTOM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  PUBLIC_HOLIDAY
  OFF_DAY
  REMOTE
}

enum ClaimType {
  MEDICAL
  TRANSPORT
  MEAL
  ACCOMMODATION
  TRAINING
  UNIFORM
  TELEPHONE
  OTHER
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum AppraisalStatus {
  DRAFT
  SELF_REVIEW
  MANAGER_REVIEW
  COMPLETED
  ACKNOWLEDGED
}

enum DisciplinaryType {
  VERBAL_WARNING
  WRITTEN_WARNING
  SHOW_CAUSE
  SUSPENSION
  DEMOTION
  TERMINATION
}

enum DisciplinaryStatus {
  OPEN
  RESPONDED
  RESOLVED
  APPEALED
  CLOSED
}

enum TrainingStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum KpiStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

// ── Shift & Schedule ──────────────────────────────────────────────────────

model ShiftTemplate {
  id          String      @id @default(cuid())
  clinicId    String
  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  name        String      // e.g. "Morning", "Evening", "Night"
  shiftType   ShiftType
  startTime   String      // "08:00"
  endTime     String      // "14:00"
  breakMins   Int         @default(30)
  isDefault   Boolean     @default(false)
  isActive    Boolean     @default(true)
  order       Int         @default(0)
  schedules   StaffSchedule[]
  createdAt   DateTime    @default(now())
  @@index([clinicId, isActive])
}

model StaffSchedule {
  id              String          @id @default(cuid())
  staffProfileId  String
  staffProfile    StaffProfile    @relation(fields: [staffProfileId], references: [id])
  clinicId        String
  clinic          Clinic          @relation(fields: [clinicId], references: [id])
  shiftTemplateId String?
  shiftTemplate   ShiftTemplate?  @relation(fields: [shiftTemplateId], references: [id])
  date            DateTime
  startTime       String?
  endTime         String?
  isOff           Boolean         @default(false)
  isPublicHoliday Boolean         @default(false)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@unique([staffProfileId, clinicId, date])
  @@index([clinicId, date])
  @@index([staffProfileId, date])
}

model DentistNursePairing {
  id               String        @id @default(cuid())
  clinicId         String
  clinic           Clinic        @relation(fields: [clinicId], references: [id])
  dentistProfileId String
  dentist          StaffProfile  @relation("DentistPairings", fields: [dentistProfileId], references: [id])
  nurseProfileId   String
  nurse            StaffProfile  @relation("NursePairings", fields: [nurseProfileId], references: [id])
  date             DateTime?     // null = default pairing (no specific date)
  shiftTemplateId  String?       // null = applies to all shifts
  isDefault        Boolean       @default(false)
  notes            String?
  createdAt        DateTime      @default(now())
  @@index([clinicId, date])
  @@index([dentistProfileId])
  @@index([nurseProfileId])
}

// ── Leave Management ──────────────────────────────────────────────────────

model LeaveBalance {
  id              String        @id @default(cuid())
  staffProfileId  String
  staffProfile    StaffProfile  @relation(fields: [staffProfileId], references: [id])
  year            Int
  leaveType       HrLeaveType
  entitled        Decimal       @db.Decimal(5,1)
  taken           Decimal       @default(0) @db.Decimal(5,1)
  pending         Decimal       @default(0) @db.Decimal(5,1)
  balance         Decimal       @db.Decimal(5,1)
  carriedOver     Decimal       @default(0) @db.Decimal(5,1)
  forfeited       Decimal       @default(0) @db.Decimal(5,1)
  @@unique([staffProfileId, year, leaveType])
  @@index([staffProfileId, year])
}

model LeaveApplication {
  id              String        @id @default(cuid())
  leaveRef        String        @unique  // LV-202506-001
  staffProfileId  String
  staffProfile    StaffProfile  @relation(fields: [staffProfileId], references: [id])
  clinicId        String
  clinic          Clinic        @relation(fields: [clinicId], references: [id])
  leaveType       HrLeaveType
  startDate       DateTime
  endDate         DateTime
  totalDays       Decimal       @db.Decimal(5,1)
  reason          String?
  attachmentUrl   String?
  status          HrLeaveStatus @default(PENDING)
  appliedAt       DateTime      @default(now())
  reviewedById    String?
  reviewedBy      User?         @relation("LeaveAppReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNote      String?
  coverRequests   LeaveCoverRequest[]
  @@index([staffProfileId, status])
  @@index([clinicId, startDate, endDate])
  @@index([status])
}

model LeaveCoverRequest {
  id                  String           @id @default(cuid())
  leaveApplicationId  String
  leaveApplication    LeaveApplication @relation(fields: [leaveApplicationId], references: [id])
  requestedStaffId    String
  requestedStaff      StaffProfile     @relation("CoverRequested", fields: [requestedStaffId], references: [id])
  offeredByStaffId    String?
  offeredByStaff      StaffProfile?    @relation("CoverOffered", fields: [offeredByStaffId], references: [id])
  status              String           // PENDING | ACCEPTED | DECLINED
  notes               String?
  createdAt           DateTime         @default(now())
  @@index([leaveApplicationId])
}

// ── Attendance (daily) ────────────────────────────────────────────────────
// NOTE: named AttendanceRecord to avoid collision with the existing monthly
// `Attendance` aggregate model used by commission proration.

model AttendanceRecord {
  id              String           @id @default(cuid())
  staffProfileId  String
  staffProfile    StaffProfile     @relation(fields: [staffProfileId], references: [id])
  clinicId        String
  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  status          AttendanceStatus @default(PRESENT)
  lateMinutes     Int?
  overtimeMinutes Int?
  /// OT worked through the lunch break. Only recordable when the clinic's
  /// payroll config allows Lunch OT (ClinicPayrollConfig.lunchOtAllowed).
  lunchOtMinutes  Int              @default(0)
  notes           String?
  recordedById    String?
  recordedBy      User?            @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@unique([staffProfileId, date])
  @@index([clinicId, date])
  @@index([staffProfileId, date])
}

// ── Claims ────────────────────────────────────────────────────────────────

model StaffClaim {
  id              String        @id @default(cuid())
  claimRef        String        @unique  // CLM-202506-001
  staffProfileId  String
  staffProfile    StaffProfile  @relation(fields: [staffProfileId], references: [id])
  clinicId        String
  clinic          Clinic        @relation(fields: [clinicId], references: [id])
  claimType       ClaimType
  amount          Decimal       @db.Decimal(10,2)
  receiptDate     DateTime
  description     String
  receiptUrl      String?
  status          ClaimStatus   @default(DRAFT)
  submittedAt     DateTime?
  reviewedById    String?
  reviewedBy      User?         @relation("ClaimReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNote      String?
  paidAt          DateTime?
  paymentRef      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([staffProfileId, status])
  @@index([clinicId, status])
  @@index([claimType])
}

// ── KPI ───────────────────────────────────────────────────────────────────

model KpiTemplate {
  id          String     @id @default(cuid())
  name        String     // e.g. "Dentist KPI 2026"
  role        Role?      // null = applies to all roles
  description String?
  isActive    Boolean    @default(true)
  metrics     KpiMetric[]
  staffKpis   StaffKpi[]
  createdAt   DateTime   @default(now())
}

model KpiMetric {
  id              String       @id @default(cuid())
  templateId      String
  template        KpiTemplate  @relation(fields: [templateId], references: [id])
  name            String       // e.g. "Patient Satisfaction Score"
  description     String?
  unit            String?      // e.g. "%", "RM", "count"
  target          Decimal?     @db.Decimal(10,2)
  weight          Decimal      @db.Decimal(5,2)
  order           Int          @default(0)
  results         KpiResult[]
  @@index([templateId])
}

model StaffKpi {
  id              String        @id @default(cuid())
  staffProfileId  String
  staffProfile    StaffProfile  @relation(fields: [staffProfileId], references: [id])
  templateId      String
  template        KpiTemplate   @relation(fields: [templateId], references: [id])
  period          String        // "2026-Q1", "2026-H1", "2026"
  status          KpiStatus     @default(DRAFT)
  overallScore    Decimal?      @db.Decimal(5,2)
  results         KpiResult[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([staffProfileId, period])
}

model KpiResult {
  id          String      @id @default(cuid())
  staffKpiId  String
  staffKpi    StaffKpi    @relation(fields: [staffKpiId], references: [id])
  metricId    String
  metric      KpiMetric   @relation(fields: [metricId], references: [id])
  actual      Decimal?    @db.Decimal(10,2)
  score       Decimal?    @db.Decimal(5,2)
  notes       String?
  @@index([staffKpiId])
}

// ── Appraisals ────────────────────────────────────────────────────────────

model Appraisal {
  id                String           @id @default(cuid())
  appraisalRef      String           @unique  // APR-2026-001
  staffProfileId    String
  staffProfile      StaffProfile     @relation(fields: [staffProfileId], references: [id])
  reviewerId        String
  reviewer          User             @relation("AppraisalReviewer", fields: [reviewerId], references: [id])
  period            String           // "2026-H1"
  status            AppraisalStatus  @default(DRAFT)
  selfRating        Decimal?         @db.Decimal(3,1)
  selfComments      String?
  managerRating     Decimal?         @db.Decimal(3,1)
  managerComments   String?
  finalRating       Decimal?         @db.Decimal(3,1)
  strengths         String?
  improvements      String?
  goals             String?
  acknowledgedAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  @@index([staffProfileId])
  @@index([status])
}

// ── Disciplinary ──────────────────────────────────────────────────────────

model Disciplinary {
  id               String             @id @default(cuid())
  discRef          String             @unique  // DIS-2026-001
  staffProfileId   String
  staffProfile     StaffProfile       @relation(fields: [staffProfileId], references: [id])
  clinicId         String
  clinic           Clinic             @relation(fields: [clinicId], references: [id])
  type             DisciplinaryType
  status           DisciplinaryStatus @default(OPEN)
  incidentDate     DateTime
  incidentDesc     String
  actionTaken      String?
  staffResponse    String?
  responseDeadline DateTime?
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?              @relation("DisciplinaryResolver", fields: [resolvedById], references: [id])
  attachmentUrls   String[]
  isConfidential   Boolean            @default(true)
  createdById      String?
  createdBy        User?              @relation("DisciplinaryCreator", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  @@index([staffProfileId])
  @@index([status])
}

// ── Training ──────────────────────────────────────────────────────────────

model Training {
  id            String          @id @default(cuid())
  title         String
  provider      String?
  type          String?         // "Internal" | "External" | "Online"
  startDate     DateTime
  endDate       DateTime
  venue         String?
  cost          Decimal?        @db.Decimal(10,2)
  maxSlots      Int?
  description   String?
  participants  StaffTraining[]
  createdAt     DateTime        @default(now())
}

model StaffTraining {
  id              String          @id @default(cuid())
  staffProfileId  String
  staffProfile    StaffProfile    @relation(fields: [staffProfileId], references: [id])
  trainingId      String
  training        Training        @relation(fields: [trainingId], references: [id])
  status          TrainingStatus  @default(PLANNED)
  completedAt     DateTime?
  score           Decimal?        @db.Decimal(5,2)
  certificateUrl  String?
  notes           String?
  @@unique([staffProfileId, trainingId])
  @@index([staffProfileId])
}

// ── Payroll ───────────────────────────────────────────────────────────────

model PayrollRun {
  id           String         @id @default(cuid())
  month        String         // "2026-06"
  clinicId     String
  clinic       Clinic         @relation(fields: [clinicId], references: [id])
  status       String         // DRAFT | PROCESSING | LOCKED | PAID
  totalGross   Decimal        @db.Decimal(12,2)
  totalNet     Decimal        @db.Decimal(12,2)
  totalEpf     Decimal        @db.Decimal(12,2)
  totalSocso   Decimal        @db.Decimal(12,2)
  totalTax     Decimal        @db.Decimal(12,2)
  runById      String?
  runBy        User?          @relation("PayrollRunner", fields: [runById], references: [id])
  approvedById String?
  approvedBy   User?          @relation("PayrollApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  // HR payroll lock — the gate that opens the payment approval workflow
  lockedById   String?
  lockedBy     User?          @relation("PayrollLocker", fields: [lockedById], references: [id])
  lockedAt     DateTime?
  paidAt       DateTime?
  slips        PaySlip[]
  bankPayments PayrollBankPayment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@unique([clinicId, month])
  @@index([month])
}

model PaySlip {
  id              String        @id @default(cuid())
  payrollRunId    String
  payrollRun      PayrollRun    @relation(fields: [payrollRunId], references: [id])
  staffProfileId  String
  staffProfile    StaffProfile  @relation(fields: [staffProfileId], references: [id])
  basicSalary     Decimal       @db.Decimal(10,2)
  allowances      Decimal       @default(0) @db.Decimal(10,2)
  overtime        Decimal       @default(0) @db.Decimal(10,2)
  commission      Decimal       @default(0) @db.Decimal(10,2)
  claims          Decimal       @default(0) @db.Decimal(10,2)
  grossSalary     Decimal       @db.Decimal(10,2)
  epfEmployee     Decimal       @db.Decimal(10,2)
  epfEmployer     Decimal       @db.Decimal(10,2)
  socsoEmployee   Decimal       @db.Decimal(10,2)
  socsoEmployer   Decimal       @db.Decimal(10,2)
  eisEmployee     Decimal       @default(0) @db.Decimal(10,2)
  eisEmployer     Decimal       @default(0) @db.Decimal(10,2)
  incomeTax       Decimal       @db.Decimal(10,2)
  unpaidLeaveDeduction Decimal  @default(0) @db.Decimal(10,2)
  otherDeductions Decimal       @default(0) @db.Decimal(10,2)
  netSalary       Decimal       @db.Decimal(10,2)
  daysWorked      Int
  daysAbsent      Int
  daysLeave       Int
  daysPublicHoliday Int         @default(0)
  overtimeMinutes Int           @default(0)
  slipUrl         String?
  // ── Payment approval workflow ──────────────────────────────────────────
  // PENDING → APPROVED (1st approver) → PAID (2nd approver signs the bank
  // payment) → RELEASED (HR hands the slip to the employee)
  status          String        @default("PENDING")
  approvedById    String?
  approvedBy      User?         @relation("PaySlipApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  approvalNote    String?
  bankPaymentId   String?
  bankPayment     PayrollBankPayment? @relation(fields: [bankPaymentId], references: [id])
  paidAt          DateTime?
  releasedById    String?
  releasedBy      User?         @relation("PaySlipReleaser", fields: [releasedById], references: [id])
  releasedAt      DateTime?
  createdAt       DateTime      @default(now())
  @@index([payrollRunId])
  @@index([staffProfileId])
  @@index([bankPaymentId])
  @@index([status])
}

enum BankPaymentStatus {
  DRAFT
  PENDING_APPROVAL
  PAID
  REJECTED
}

/// A bank payment batch prepared by Accounts for a set of approved payslips.
/// Accounts prepares/uploads it but may never approve it — only the clinic's
/// configured 2nd payment approver can, which releases the money (PAID).
model PayrollBankPayment {
  id              String            @id @default(cuid())
  paymentRef      String            @unique   // BP-202606-001
  clinicId        String
  clinic          Clinic            @relation(fields: [clinicId], references: [id])
  payrollRunId    String
  payrollRun      PayrollRun        @relation(fields: [payrollRunId], references: [id])
  status          BankPaymentStatus @default(PENDING_APPROVAL)
  totalAmount     Decimal           @db.Decimal(12,2)
  bankName        String?
  accountNo       String?
  paymentDate     DateTime?
  fileUrl         String?           // uploaded bank payment / giro file
  fileName        String?
  notes           String?
  preparedById    String
  preparedBy      User              @relation("BankPaymentPreparer", fields: [preparedById], references: [id])
  preparedAt      DateTime          @default(now())
  approvedById    String?
  approvedBy      User?             @relation("BankPaymentApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  approvalNote    String?
  rejectedById    String?
  rejectedBy      User?             @relation("BankPaymentRejecter", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?
  slips           PaySlip[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  @@index([clinicId, status])
  @@index([payrollRunId])
}

/// Per-clinic payroll configuration. Payment approvers, the branch Head Nurse
/// who may submit monthly attendance, and the Lunch OT permission all live
/// here so nothing is hard-coded to the PV director/PIC.
model ClinicPayrollConfig {
  id                      String        @id @default(cuid())
  clinicId                String        @unique
  clinic                  Clinic        @relation(fields: [clinicId], references: [id])
  // Payment approvers (independent of the Payment Voucher director/PIC)
  firstApproverId         String?
  firstApprover           User?         @relation("PayrollFirstApprover", fields: [firstApproverId], references: [id])
  secondApproverId        String?
  secondApprover          User?         @relation("PayrollSecondApprover", fields: [secondApproverId], references: [id])
  // Branch Head Nurse — the only staff member who may submit monthly attendance
  headNurseStaffProfileId String?
  headNurse               StaffProfile? @relation("ClinicHeadNurse", fields: [headNurseStaffProfileId], references: [id])
  // Lunch OT is a clinic-level permission, not an attendance exception reason
  lunchOtAllowed          Boolean       @default(false)
  lunchOtMaxMinutes       Int           @default(60)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  @@index([headNurseStaffProfileId])
}

/// Monthly attendance sign-off for a branch. Submitted by the designated
/// Head Nurse only; payroll for the month cannot be locked without it.
model AttendanceMonthSubmission {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  month         String   // "2026-06"
  staffCount    Int      @default(0)
  recordCount   Int      @default(0)
  notes         String?
  submittedById String
  submittedBy   User     @relation("AttendanceMonthSubmitter", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())
  @@unique([clinicId, month])
  @@index([month])
}

model ClaimLimit {
  id          String    @id @default(cuid())
  claimType   ClaimType
  limitAmount Decimal   @db.Decimal(10,2)
  period      String    // "MONTHLY" | "YEARLY" | "PER_TRIP"
  isActive    Boolean   @default(true)
  @@unique([claimType])
}

// ── Staff Documents ───────────────────────────────────────────────────────
model StaffDocument {
  id              String        @id @default(cuid())
  staffProfileId  String
  staffProfile    StaffProfile  @relation(fields: [staffProfileId], references: [id])
  title           String
  category        String        // "Identity" | "Contract" | "Certificate" | "Medical" | "Other"
  fileUrl         String
  fileSize        Int?
  mimeType        String?
  expiryDate      DateTime?
  uploadedById    String?
  uploadedBy      User?         @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt       DateTime      @default(now())
  @@index([staffProfileId])
}

// ── Employment History ────────────────────────────────────────────────────
model EmploymentHistory {
  id              String           @id @default(cuid())
  staffProfileId  String
  staffProfile    StaffProfile     @relation(fields: [staffProfileId], references: [id])
  action          String           // "CONFIRMED" | "SUSPENDED" | "RESIGNED" | "TERMINATED" | "REINSTATED"
  fromStatus      EmploymentStatus
  toStatus        EmploymentStatus
  reason          String?
  effectiveDate   DateTime
  performedById   String
  performedBy     User             @relation("EmploymentHistoryPerformer", fields: [performedById], references: [id])
  createdAt       DateTime         @default(now())
  @@index([staffProfileId])
}

// ── Clinic staffing minimums (for low-staff alerts) ──────────────────────
model ClinicStaffMinimum {
  id        String  @id @default(cuid())
  clinicId  String
  clinic    Clinic  @relation(fields: [clinicId], references: [id])
  role      Role
  minCount  Int     @default(1)
  @@unique([clinicId, role])
  @@index([clinicId])
}

