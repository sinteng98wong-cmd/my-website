// ── Payment Vouchers ──────────────────────────────────────────────────────

enum PVStatus {
  DRAFT
  PENDING_DIRECTOR
  PENDING_PIC
  APPROVED
  PAID
  REJECTED
}

enum SupplierInvoiceType {
  GENERAL
  LAB
  MATERIALS
  INTERBRANCH
}

model ExpenseCategory {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  isActive    Boolean           @default(true)
  order       Int               @default(0)
  invoices    SupplierInvoice[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([isActive])
}

model PaymentVoucher {
  id                   String      @id @default(cuid())
  pvRef                String      @unique
  clinicId             String
  clinic               Clinic      @relation(fields: [clinicId], references: [id])
  supplierId           String?
  supplier             Supplier?   @relation(fields: [supplierId], references: [id])
  fromClinicId         String?
  fromClinic           Clinic?     @relation("InterBranchFrom", fields: [fromClinicId], references: [id])
  status               PVStatus    @default(DRAFT)
  totalAmount          Decimal     @db.Decimal(12,2)
  bankName             String?
  accountNo            String?
  accountName          String?
  paymentRef           String?
  paymentDate          DateTime?
  notes                String?
  preparedById         String?
  preparedBy           User?       @relation("PVPrepared", fields: [preparedById], references: [id])
  submittedAt          DateTime?
  directorId           String?
  directorApprovedById String?
  directorApprovedBy   User?       @relation("PVDirectorApproved", fields: [directorApprovedById], references: [id])
  directorApprovedAt   DateTime?
  directorNote         String?
  picId                String?
  picApprovedById      String?
  picApprovedBy        User?       @relation("PVPicApproved", fields: [picApprovedById], references: [id])
  picApprovedAt        DateTime?
  picNote              String?
  rejectedById         String?
  rejectedBy           User?       @relation("PVRejected", fields: [rejectedById], references: [id])
  rejectedAt           DateTime?
  rejectionReason      String?
  paidById             String?
  paidBy               User?       @relation("PVPaid", fields: [paidById], references: [id])
  paidAt               DateTime?
  invoices             SupplierInvoice[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  @@index([clinicId, status])
  @@index([supplierId])
  @@index([status])
}

model SupplierInvoice {
  id             String              @id @default(cuid())
  pvId           String
  pv             PaymentVoucher      @relation(fields: [pvId], references: [id])
  invoiceType    SupplierInvoiceType @default(GENERAL)
  invoiceNo      String
  invoiceDate    DateTime
  description    String
  amount         Decimal             @db.Decimal(10,2)
  categoryId     String?
  category       ExpenseCategory?    @relation(fields: [categoryId], references: [id])
  attachmentUrl  String?
  attachmentName String?
  labJobId       String?
  labJob         LabJob?             @relation(fields: [labJobId], references: [id])
  stockInvoiceId String?
  stockInvoice   StockInvoice?       @relation(fields: [stockInvoiceId], references: [id])
  poolOrderId    String?
  poolOrder      PoolOrder?          @relation(fields: [poolOrderId], references: [id])
  fromClinicId   String?
  fromClinic     Clinic?             @relation("SupplierInvoiceFromClinic", fields: [fromClinicId], references: [id])
  notes          String?
  createdAt      DateTime            @default(now())
  @@index([pvId])
  @@index([labJobId])
  @@index([stockInvoiceId])
}

// ── Licenses & Compliance ─────────────────────────────────────────────────

enum LicenseScope {
  CLINIC
  DOCTOR
}

enum LicenseStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  ARCHIVED
}

model LicenseType {
  id          String       @id @default(cuid())
  name        String
  code        String?
  scope       LicenseScope
  issuingBody String?
  description String?
  isActive    Boolean      @default(true)
  order       Int          @default(0)
  licenses    License[]
  createdAt   DateTime     @default(now())

  @@index([scope, isActive])
}

model License {
  id              String        @id @default(cuid())
  licenseTypeId   String
  licenseType     LicenseType   @relation(fields: [licenseTypeId], references: [id])
  scope           LicenseScope
  clinicId        String?
  clinic          Clinic?       @relation(fields: [clinicId], references: [id])
  staffProfileId  String?
  staffProfile    StaffProfile? @relation(fields: [staffProfileId], references: [id])
  licenseNo       String?
  issuedDate      DateTime?
  expiryDate      DateTime
  status          LicenseStatus @default(ACTIVE)
  documentUrl     String?
  documentName    String?
  notes           String?
  alert90Sent     Boolean       @default(false)
  alert60Sent     Boolean       @default(false)
  alert30Sent     Boolean       @default(false)
  alert7Sent      Boolean       @default(false)
  expiredAlertSent Boolean      @default(false)
  previousLicenseId String?     @unique
  previousLicense   License?    @relation("LicenseRenewal", fields: [previousLicenseId], references: [id])
  renewedTo         License?    @relation("LicenseRenewal")
  createdById     String?
  createdBy       User?         @relation("LicenseCreator", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clinicId, status])
  @@index([staffProfileId, status])
  @@index([expiryDate])
  @@index([status])
}

// ── Payment Method Settlement Config ──────────────────────────────────────
// Per-clinic, per-method settlement timing (days until money is received) and
// merchant charge rate. Drives expectedSettlementDate on InvoicePayment.

model PaymentMethodConfig {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  method         PaymentMethod
  subType        String?       // e.g. "VISA_MC" | "AMEX" for CREDIT_CARD
  chargeRate     Decimal       @default(0) @db.Decimal(5,2)
  settlementDays Int           @default(0)
  isActive       Boolean       @default(true)
  updatedAt      DateTime      @updatedAt

  @@unique([clinicId, method, subType])
  @@index([clinicId])
}

// ── Settlement Bank / Acquirer ────────────────────────────────────────────
// The bank/acquirer that processes a payment determines how many days until
// the money is actually received (e.g. Maybank T+2, CIMB T+3). Picked per
// payment; drives expectedSettlementDate.

model SettlementBank {
  id             String           @id @default(cuid())
  name           String
  settlementDays Int              @default(0)
  isActive       Boolean          @default(true)
  payments       InvoicePayment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([isActive])
}

// ── Digital Consent Forms ─────────────────────────────────────────────────

enum ConsentFormType {
  GENERAL
  TREATMENT
}

enum ConsentFieldType {
  TEXT
  LONG_TEXT
  YES_NO
  CHECKBOX
  MULTIPLE_CHOICE
  DATE
  SIGNATURE
}

enum ConsentRequestStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

model ConsentFormTemplate {
  id            String             @id @default(cuid())
  name          String
  type          ConsentFormType
  treatmentType String?
  description   String?
  introText     String?
  consentText   String?
  isActive      Boolean            @default(true)
  version       Int                @default(1)
  fields        ConsentFormField[]
  requests      ConsentRequest[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([type, isActive])
}

model ConsentFormField {
  id            String              @id @default(cuid())
  templateId    String
  template      ConsentFormTemplate @relation(fields: [templateId], references: [id])
  label         String
  fieldType     ConsentFieldType
  isRequired    Boolean             @default(false)
  order         Int
  options       String[]
  placeholder   String?
  helpText      String?
  showIfFieldId String?
  showIfValue   String?
  createdAt     DateTime            @default(now())

  @@index([templateId])
}

model ConsentRequest {
  id              String               @id @default(cuid())
  templateId      String
  template        ConsentFormTemplate  @relation(fields: [templateId], references: [id])
  patientId       String
  patient         Patient              @relation(fields: [patientId], references: [id])
  clinicId        String
  clinic          Clinic               @relation(fields: [clinicId], references: [id])
  treatmentPlanId String?
  token           String               @unique
  expiresAt       DateTime
  status          ConsentRequestStatus @default(PENDING)
  responses       Json?
  signatureUrl    String?
  signedByName    String?
  signedAt        DateTime?
  signedIp        String?
  signMethod      String?
  pdfUrl          String?
  sentById        String?
  sentBy          User?                @relation("ConsentSender", fields: [sentById], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([patientId])
  @@index([token])
  @@index([status])
}

// ── Treatment Plans ───────────────────────────────────────────────────────

enum TreatmentPlanStatus {
  DRAFT
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum PlanPaymentMode {
  DEPOSIT_BALANCE
  PAY_PER_STAGE
  FULL_UPFRONT
}

model TreatmentStageTemplate {
  id              String           @id @default(cuid())
  treatmentTypeId String
  treatmentType   TreatmentType    @relation(fields: [treatmentTypeId], references: [id])
  name            String
  description     String?
  order           Int
  defaultCost     Decimal?         @db.Decimal(10,2)
  estimatedDays   Int?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  stages          TreatmentStage[]

  @@index([treatmentTypeId])
}

model TreatmentPlan {
  id                     String              @id @default(cuid())
  planRef                String              @unique
  patientId              String
  patient                Patient             @relation(fields: [patientId], references: [id])
  clinicId               String
  clinic                 Clinic              @relation(fields: [clinicId], references: [id])
  dentistId              String
  dentist                User                @relation("PlanDentist", fields: [dentistId], references: [id])
  treatmentTypeId        String?             // the treatment type this case is for (used to link recorded treatments to their plan)
  title                  String
  toothCodes             String[]
  status                 TreatmentPlanStatus @default(DRAFT)
  paymentMode            PlanPaymentMode     @default(DEPOSIT_BALANCE)
  subtotal               Decimal             @db.Decimal(10,2)
  discount               Decimal             @default(0) @db.Decimal(10,2)
  sstAmount              Decimal             @default(0) @db.Decimal(10,2)
  totalAmount            Decimal             @db.Decimal(10,2)
  depositRequired        Decimal             @default(0) @db.Decimal(10,2)
  totalPaid              Decimal             @default(0) @db.Decimal(10,2)
  acceptedAt             DateTime?
  acceptedByName         String?
  acceptanceSignatureUrl String?
  quotedAt               DateTime?
  completedAt            DateTime?
  notes                  String?
  stages                 TreatmentStage[]
  payments               TreatmentPlanPayment[]
  locumPayoutLines       LocumPayoutLine[]
  createdById            String?
  createdBy              User?               @relation("PlanCreator", fields: [createdById], references: [id])
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([patientId, status])
  @@index([clinicId, status])
  @@index([dentistId])
}

model TreatmentStage {
  id            String                  @id @default(cuid())
  planId        String
  plan          TreatmentPlan           @relation(fields: [planId], references: [id])
  templateId    String?
  template      TreatmentStageTemplate? @relation(fields: [templateId], references: [id])
  name          String
  description   String?
  order         Int
  status        StageStatus             @default(PENDING)
  cost          Decimal                 @default(0) @db.Decimal(10,2)
  visitId       String?
  visit         Visit?                  @relation(fields: [visitId], references: [id])
  performedById String?
  performedBy   User?                   @relation("StagePerformer", fields: [performedById], references: [id])
  completedAt   DateTime?
  clinicalNotes String?
  nextStageDate DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([planId])
  @@index([visitId])
  @@index([templateId])
}

model TreatmentPlanPayment {
  id           String        @id @default(cuid())
  planId       String
  plan         TreatmentPlan @relation(fields: [planId], references: [id])
  amount       Decimal       @db.Decimal(10,2)
  paymentType  String        // "DEPOSIT" | "STAGE" | "BALANCE" | "OTHER"
  stageId      String?
  invoiceId    String?
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  paidAt       DateTime      @default(now())
  recordedById String?
  recordedBy   User?         @relation("PlanPaymentRecorder", fields: [recordedById], references: [id])
  notes        String?

  @@index([planId])
}

// ── Monthly Reconciliation ─────────────────────────────────────────────────

enum ReconStatus {
  OPEN
  LOCKED
}

model MonthlyRecon {
  id            String                  @id @default(cuid())
  clinicId      String
  clinic        Clinic                  @relation(fields: [clinicId], references: [id])
  month         String                  // "YYYY-MM"
  status        ReconStatus             @default(OPEN)
  lockedAt      DateTime?
  lockedById    String?
  lockedBy      User?                   @relation("ReconLockedBy", fields: [lockedById], references: [id])
  notes         String?
  methodEntries MethodSettlementEntry[]
  remittances   PanelRemittance[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([clinicId, month])
  @@index([clinicId])
}

model MethodSettlementEntry {
  id              String        @id @default(cuid())
  reconId         String
  recon           MonthlyRecon  @relation(fields: [reconId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  // null = current-month settlement; "YYYY-MM" = carry-forward from a prior month received this month
  sourceMonth     String?
  confirmedAmount Decimal       @db.Decimal(10,2)
  notes           String?
  confirmedById   String?
  confirmedBy     User?         @relation("MethodSettlementConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt     DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([reconId, method, sourceMonth])
  @@index([reconId])
}

model PanelRemittance {
  id              String               @id @default(cuid())
  reconId         String
  recon           MonthlyRecon         @relation(fields: [reconId], references: [id], onDelete: Cascade)
  clinicId        String
  clinic          Clinic               @relation(fields: [clinicId], references: [id])
  panelProviderId String
  panelProvider   PanelProvider        @relation(fields: [panelProviderId], references: [id])
  remittanceRef   String?
  receivedDate    DateTime
  totalAmount     Decimal              @db.Decimal(10,2)
  notes           String?
  items           PanelRemittanceItem[]
  createdById     String?
  createdBy       User?                @relation("PanelRemittanceCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([reconId])
  @@index([clinicId])
}

model PanelRemittanceItem {
  id               String          @id @default(cuid())
  remittanceId     String
  remittance       PanelRemittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  invoicePaymentId String
  invoicePayment   InvoicePayment  @relation(fields: [invoicePaymentId], references: [id])
  allocatedAmount  Decimal         @db.Decimal(10,2)
  matchType        String          @default("AUTO")   // "AUTO" | "MANUAL"
  createdAt        DateTime        @default(now())

  @@unique([remittanceId, invoicePaymentId])
  @@index([invoicePaymentId])
}

// ── Locum Payout Workflow ─────────────────────────────────────────────────────

enum LocumPayoutStatus {
  ENTITLED
  LOCKED_PENDING_COMPLETION
  PENDING_RELEASE
  PAID
  VOIDED
}

enum LocumTreatmentCategory {
  ONE_OFF
  MULTI_STAGE
  ORTHO_BONDING
  ORTHO_DEBONDING
  ALIGNER
}

/// One payout line per treatment per locum doctor.
/// Tracks the 6-step verification workflow and category-specific release rules.
model LocumPayoutLine {
  id              String                 @id @default(cuid())

  treatmentId     String
  treatment       Treatment              @relation(fields: [treatmentId], references: [id])
  doctorProfileId String
  doctorProfile   DoctorProfile          @relation(fields: [doctorProfileId], references: [id])
  clinicId        String
  clinic          Clinic                 @relation(fields: [clinicId], references: [id])
  month           String                 // "YYYY-MM"

  // Category determines release rules
  category        LocumTreatmentCategory

  // Financial snapshot (re-computed when lab fee is confirmed)
  billedAmount    Decimal                @db.Decimal(10,2)
  collectedAmount Decimal                @db.Decimal(10,2)
  labFee          Decimal                @default(0) @db.Decimal(10,2)
  labFeeConfirmed Boolean                @default(false) // true = physical invoice logged
  sst             Decimal                @default(0) @db.Decimal(10,2)
  doctorSplit     Decimal                @db.Decimal(5,2)
  netPool         Decimal                @db.Decimal(10,2) // billedAmount − labFee − sst
  entitledAmount  Decimal                @db.Decimal(10,2) // netPool × doctorSplit%
  releasedAmount  Decimal                @default(0) @db.Decimal(10,2) // may be < entitledAmount (ortho/aligner partial)

  // Ortho: some branches track release % against patient payment progress
  orthoPaymentTrackEnabled Boolean       @default(false)

  // Workflow status
  status           LocumPayoutStatus     @default(ENTITLED)

  // Override: manager force-released a LOCKED line early
  forceReleasedBy  String?
  forceReleasedAt  DateTime?

  // Voided
  voidedAt         DateTime?
  voidedBy         String?
  voidReason       String?

  // ── 6-Step Verification Gates ──────────────────────────────────────────
  counterVerifiedAt  DateTime?           // Step 1: counter reconciles collected cash
  counterVerifiedBy  String?
  doctorVerifiedAt   DateTime?           // Step 2: doctor verifies payment vs package price
  doctorVerifiedBy   String?
  labFeeLoggedAt     DateTime?           // Step 3: physical lab invoice cost confirmed
  labFeeLoggedBy     String?
  completionMarkedAt DateTime?           // Step 4: doctor marks case stage as done
  completionMarkedBy String?
  pendingReleaseAt   DateTime?           // Step 5: all conditions met → PENDING_RELEASE
  paidAt             DateTime?           // Step 6: manager marks PAID
  paidBy             String?

  // Link to treatment plan for multi-stage / ortho / aligner release rules
  treatmentPlanId  String?
  treatmentPlan    TreatmentPlan?        @relation(fields: [treatmentPlanId], references: [id])
  treatmentStageId String?               // specific stage that triggered this line

  // Clinical detail for the payout listing
  subType          String?               // material / variant, e.g. "PFM", "Valplast"
  toothCodes       String?               // e.g. "16" or "11,12"

  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([treatmentId, doctorProfileId])
  @@index([doctorProfileId, month])
  @@index([status])
  @@index([clinicId, month])
}

// ── Payout stage-release schemes (configurable per clinic) ─────────────────
// Defines how a case's entitlement is released stage-by-stage, e.g.
// RCT: Access Cavity 15% → Bio Prep 35% → Canal Seal 35% → Permanent Filling 15%
// stages JSON: [{ name, percent, requiresLabInvoice?, paymentThresholdPct?, requiresCaseComplete? }]

model PayoutScheme {
  id             String   @id @default(cuid())
  clinicId       String?  // null = global default; a clinic row overrides the global one with the same name
  clinic         Clinic?  @relation(fields: [clinicId], references: [id])
  name           String   // "RCT", "Denture", "Crown / Bridge", "Ortho", "Aligner"
  matchCodes     String[] // TreatmentType.code / subType patterns (case-insensitive substring)
  subTypes       String[] // selectable variants, e.g. ["PFM","Zirconia"] or ["Valplast","Acrylic"]
  paymentTracked Boolean  @default(false) // release follows patient payment progress instead of stages
  stages         Json     // ordered stage rules; percents should sum to 100
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clinicId, name])
  @@index([clinicId])
}

// ── Scan flat commission rates (configurable per clinic) ───────────────────
// Scans pay the doctor a FLAT amount per scan (not a share of the billed
// price): OPG 20, Lateral 15, EMS 100, iTero 40, CBCT 35, etc.
model PayoutScanRate {
  id        String   @id @default(cuid())
  clinicId  String?  // null = global default; a clinic row overrides it
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  code      String   // TreatmentType.code, e.g. OPG, LATERAL_CEPH, EMS, INTRAORAL_SCAN, CBCT
  label     String   // display name for the slip
  rate      Decimal  @db.Decimal(10,2) // flat commission per scan
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([clinicId, code])
  @@index([clinicId])
}

// ── Weekly staff rostering (Doctor / Nurse shifts across branches) ─────────
enum ShiftStatus {
  PENDING
  APPROVED
}

model Shift {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation("UserShifts", fields: [userId], references: [id])
  branchId  String      // Clinic acts as the branch / location entity
  branch    Clinic      @relation("BranchShifts", fields: [branchId], references: [id])
  startTime DateTime
  endTime   DateTime
  status    ShiftStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // A user cannot hold overlapping shifts even across different branches —
  // enforced at the DB level by a btree_gist EXCLUDE constraint added in the
  // migration (see migration.sql), plus the app-level conflict engine.
  @@index([userId, startTime])
  @@index([branchId, startTime])
}
