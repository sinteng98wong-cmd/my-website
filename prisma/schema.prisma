// DentalOS — Prisma Schema v1.0
// Multi-clinic dental ERP — 5 entities, 10 clinics, Malaysia

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Org ──────────────────────────────────────────────────────────────────

model Entity {
  id              String   @id @default(cuid())
  legalName       String
  sstRegistered   Boolean  @default(false)
  eInvoiceEnabled Boolean  @default(false)
  panelEnabled    Boolean  @default(false)
  sstOnForeigner  Boolean  @default(false)

  // Company identity
  name                  String?
  tradingName           String?
  registrationNo        String?
  oldRegistrationNo     String?
  incorporationDate     DateTime?

  // Address
  address   String?
  city      String?
  state     String?
  postcode  String?
  country   String    @default("Malaysia")

  // Contact
  phone    String?
  email    String?
  website  String?
  logoUrl  String?

  // Financial Year
  financialYearStartMonth Int @default(1)

  // SST
  sstRegistrationNo  String?
  sstEffectiveDate   DateTime?
  sstFilingFrequency String    @default("BI_MONTHLY")

  // e-Invoice
  tin                   String?
  myInvoisClientId      String?
  myInvoisClientSecret  String?
  myInvoisEnvironment   String   @default("SANDBOX")
  eInvoiceEffectiveDate DateTime?

  // Director
  directorName String?
  directorIcNo String?

  // Bank account (used when pvMode = GROUPED — shared across all branches)
  bankName        String?
  bankAccountNo   String?
  bankAccountName String?

  // PV mode: GROUPED = one PV for all branches sharing same bank account
  //          PER_CLINIC = separate PV per branch using each branch's bank account
  pvMode String @default("PER_CLINIC")

  // Status
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinics         Clinic[]
  stockInvoices   StockInvoice[]
  eInvoiceBatches EInvoiceBatch[]

  @@index([isActive])
}

model Clinic {
  id               String           @id @default(cuid())
  name             String
  slug             String?          @unique  // kebab-case, used for public intake URLs
  entityId         String
  entity           Entity           @relation(fields: [entityId], references: [id])
  isHQ             Boolean          @default(false)
  panelProviders   PanelProvider[]
  patients         Patient[]
  clinicReferrals           Patient[]            @relation("ClinicReferrals")
  clinicReferralCommissions ReferralCommission[] @relation("ClinicReferralCommissions")
  userClinics      UserClinic[]
  schedules        Schedule[]
  branchShifts     Shift[]          @relation("BranchShifts")
  clinicStock      ClinicStock[]
  receivedDOs      DeliveryOrder[]  @relation("ReceivingClinic")
  dispatchedDOs    DeliveryOrder[]  @relation("DispatchingClinic")
  initiatedPools   PoolOrder[]      @relation("InitiatingClinic")
  poolParticipations PoolParticipant[]
  commissionConfigs    CommissionConfig[]
  ledgerEntries        DailyLedger[]
  mcs                  MedicalCertificate[]
  labJobs              LabJob[]              @relation("LabJobClinic")
  labVendors           LabVendor[]
  roleClinicConfigs    RoleClinicConfig[]
  ledgerAccountCodes   LedgerAccountCode[]
  cashBankings         CashBanking[]
  appointments         Appointment[]
  visits               Visit[]
  stockBatches         StockBatch[]
  purchaseOrders       PurchaseOrder[]  @relation("POReceivingClinic")
  userClinicModules    UserClinicModule[]
  // HRMS relations
  payrollRuns          PayrollRun[]
  shiftTemplates       ShiftTemplate[]
  staffSchedules       StaffSchedule[]
  dentistNursePairings DentistNursePairing[]
  leaveApplications    LeaveApplication[]
  attendanceRecords    AttendanceRecord[]
  claims               StaffClaim[]
  disciplinaries       Disciplinary[]
  staffMinimums        ClinicStaffMinimum[]
  patientDeposits      PatientDeposit[]
  salesReturns         SalesReturn[]
  eInvoiceBatches      EInvoiceBatch[]
  creditNotes          EInvoiceCreditNote[]
  debitNotes           EInvoiceDebitNote[]
  licenses             License[]
  paymentMethodConfigs PaymentMethodConfig[]
  treatmentPlans       TreatmentPlan[]
  consentRequests      ConsentRequest[]
  locumPayoutLines     LocumPayoutLine[]
  payoutSchemes        PayoutScheme[]
  payoutScanRates      PayoutScanRate[]
  stockMovements       StockMovement[]
  stockTakes           StockTake[]
  stockIssues          StockIssue[]

  // Branch contact info
  address    String?
  city       String?
  state      String?
  postcode   String?
  phone      String?
  email      String?

  // Branch bank account (used when entity pvMode = PER_CLINIC)
  bankName       String?
  bankAccountNo  String?
  bankAccountName String?

  // PV grouping tag — branches with same tag share one PV (entity pvMode = GROUPED)
  pvGroupTag String?

  // Payment Voucher approvers
  directorId String?
  director   User?   @relation("ClinicDirector", fields: [directorId], references: [id])
  picId      String?
  pic        User?   @relation("ClinicPic", fields: [picId], references: [id])

  // Payment Voucher relations
  paymentVouchers      PaymentVoucher[]
  interBranchPVs       PaymentVoucher[]  @relation("InterBranchFrom")
  supplierInvoicesFrom SupplierInvoice[] @relation("SupplierInvoiceFromClinic")
  // Reconciliation
  monthlyRecons        MonthlyRecon[]
  panelRemittances     PanelRemittance[]
  doctorDailySignoffs  DoctorDailySignoff[]
  // Payroll payment workflow
  payrollConfig            ClinicPayrollConfig?
  payrollBankPayments      PayrollBankPayment[]
  attendanceMonthSubmissions AttendanceMonthSubmission[]

  @@index([entityId])
}

model PanelProvider {
  id        String    @id @default(cuid())
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  name            String
  code            String
  active          Boolean          @default(true)
  invoicePayments InvoicePayment[]
  tin             String?
  registrationNo  String?
  eInvoiceBatches EInvoiceBatch[]
  remittances     PanelRemittance[]
}

// ── Users ────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  FINANCE
  CLINIC_MANAGER
  DOCTOR
  NURSE
  RECEPTIONIST
  STOREKEEPER
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String
  role          Role
  active        Boolean       @default(true)
  userClinics   UserClinic[]
  doctorProfile      DoctorProfile?
  staffProfile       StaffProfile?
  issuedMCs          MedicalCertificate[]
  doctorSchedules    Schedule[]     @relation("DoctorSchedule")
  nurseSchedules     Schedule[]     @relation("NurseSchedule")
  receptionistSchedules Schedule[]  @relation("ReceptionistSchedule")
  shifts             Shift[]        @relation("UserShifts")
  doctorAppointments Appointment[]  @relation("DoctorAppointments")
  ledgerEdits        DailyLedger[]
  deletedPatients    Patient[]      @relation("PatientDeletedBy")
  deletedVisits      Visit[]        @relation("VisitDeletedBy")
  deletedInvoices    Invoice[]      @relation("InvoiceDeletedBy")
  userClinicModules  UserClinicModule[]
  // Pool Order relations
  raisedPoolOrders         PoolOrder[]       @relation("PoolOrderRaisedBy")
  approvedPoolOrders       PoolOrder[]       @relation("PoolOrderApprovedBy")
  reopenedPoolOrders       PoolOrder[]       @relation("PoolOrderReopenedBy")
  joinedPoolParticipations PoolParticipant[] @relation("PoolParticipantJoinedBy")
  // Delivery Order relations
  raisedDOs                DeliveryOrder[]   @relation("DORaisedBy")
  approvedDOs              DeliveryOrder[]   @relation("DOApprovedBy")
  // Purchase Order relations
  raisedPOs                PurchaseOrder[]   @relation("PORaisedBy")
  // Referral relations
  doctorReferrals               Patient[]            @relation("DoctorReferrals")
  doctorReferralCommissions     ReferralCommission[] @relation("DoctorCommissions")
  approvedReferralCommissions   ReferralCommission[] @relation("ReferralCommissionApprovals")
  paidReferralCommissions       ReferralCommission[] @relation("ReferralCommissionPayments")
  // HRMS relations
  reviewedLeaveApplications     LeaveApplication[] @relation("LeaveAppReviewer")
  reviewedClaims                StaffClaim[]       @relation("ClaimReviewer")
  attendanceRecords             AttendanceRecord[] @relation("AttendanceRecorder")
  appraisalReviews              Appraisal[]        @relation("AppraisalReviewer")
  resolvedDisciplinaries        Disciplinary[]     @relation("DisciplinaryResolver")
  createdDisciplinaries         Disciplinary[]     @relation("DisciplinaryCreator")
  payrollRuns                   PayrollRun[]       @relation("PayrollRunner")
  payrollApprovals              PayrollRun[]       @relation("PayrollApprover")
  uploadedDocuments             StaffDocument[]    @relation("DocumentUploader")
  employmentActions             EmploymentHistory[] @relation("EmploymentHistoryPerformer")
  depositTransactions           PatientDeposit[]   @relation("DepositCreator")
  salesReturnCreations          SalesReturn[]      @relation("SalesReturnCreator")
  submittedBatches              EInvoiceBatch[]    @relation("BatchSubmitter")
  createdCNs                    EInvoiceCreditNote[] @relation("CNCreator")
  createdDNs                    EInvoiceDebitNote[]  @relation("DNCreator")
  // Clinic approver relations
  directorOfClinics   Clinic[] @relation("ClinicDirector")
  picOfClinics        Clinic[] @relation("ClinicPic")
  // Payment Voucher relations
  preparedPVs         PaymentVoucher[] @relation("PVPrepared")
  directorApprovedPVs PaymentVoucher[] @relation("PVDirectorApproved")
  picApprovedPVs      PaymentVoucher[] @relation("PVPicApproved")
  rejectedPVs         PaymentVoucher[] @relation("PVRejected")
  paidPVs             PaymentVoucher[] @relation("PVPaid")
  createdLicenses      License[]              @relation("LicenseCreator")
  sentConsents         ConsentRequest[]       @relation("ConsentSender")
  // Treatment plan relations
  planDentist          TreatmentPlan[]        @relation("PlanDentist")
  createdPlans         TreatmentPlan[]        @relation("PlanCreator")
  performedStages      TreatmentStage[]       @relation("StagePerformer")
  recordedPlanPayments TreatmentPlanPayment[] @relation("PlanPaymentRecorder")
  // Reconciliation relations
  lockedRecons               MonthlyRecon[]           @relation("ReconLockedBy")
  confirmedMethodSettlements MethodSettlementEntry[]  @relation("MethodSettlementConfirmedBy")
  createdRemittances         PanelRemittance[]        @relation("PanelRemittanceCreatedBy")
  // Payroll payment workflow relations
  lockedPayrollRuns          PayrollRun[]                @relation("PayrollLocker")
  firstApproverOfClinics     ClinicPayrollConfig[]       @relation("PayrollFirstApprover")
  secondApproverOfClinics    ClinicPayrollConfig[]       @relation("PayrollSecondApprover")
  approvedPaySlips           PaySlip[]                   @relation("PaySlipApprover")
  releasedPaySlips           PaySlip[]                   @relation("PaySlipReleaser")
  preparedBankPayments       PayrollBankPayment[]        @relation("BankPaymentPreparer")
  approvedBankPayments       PayrollBankPayment[]        @relation("BankPaymentApprover")
  rejectedBankPayments       PayrollBankPayment[]        @relation("BankPaymentRejecter")
  submittedAttendanceMonths  AttendanceMonthSubmission[] @relation("AttendanceMonthSubmitter")
  stockMovements             StockMovement[]             @relation("StockMovementCreator")
  createdStockTakes          StockTake[]                 @relation("StockTakeCreator")
  submittedStockTakes        StockTake[]                 @relation("StockTakeSubmitter")
  reviewedStockTakes         StockTake[]                 @relation("StockTakeReviewer")
  countedStockTakeLines      StockTakeLine[]             @relation("StockTakeCounter")
  createdStockIssues         StockIssue[]                @relation("StockIssueCreator")
  submittedStockIssues       StockIssue[]                @relation("StockIssueSubmitter")
  reviewedStockIssues        StockIssue[]                @relation("StockIssueReviewer")
  createdAt            DateTime               @default(now())
}

model UserClinic {
  userId       String
  clinicId     String
  roleOverride Role?    // null = use User.role; set to override for this branch only
  user         User     @relation(fields: [userId], references: [id])
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  @@id([userId, clinicId])
}

// ── Doctors ──────────────────────────────────────────────────────────────

enum DoctorType {
  LOCUM
  PERMANENT
}

enum RateType {
  DAY
  HOUR
}

model DoctorProfile {
  id             String                @id @default(cuid())
  userId         String                @unique
  user           User                  @relation(fields: [userId], references: [id])
  type           DoctorType
  defaultRate    Decimal               @db.Decimal(5,2)
  dayRate        Decimal?              @db.Decimal(10,2)
  hourRate       Decimal?              @db.Decimal(10,2)
  rateType       RateType?
  treatmentRates         DoctorTreatmentRate[]
  engagements            LocumEngagement[]
  treatments             Treatment[]
  reconciliationStatements LocumReconciliationStatement[]
  dailySignoffs            DoctorDailySignoff[]
  locumPayoutLines         LocumPayoutLine[]
}

model DoctorTreatmentRate {
  id              String        @id @default(cuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  treatmentTypeId String
  treatmentType   TreatmentType @relation(fields: [treatmentTypeId], references: [id])
  rate            Decimal       @db.Decimal(5,2)
  effectiveFrom   DateTime      @default(now())
}

model LocumEngagement {
  id              String        @id @default(cuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  clinicId        String
  month           String
  sessionsWorked  Int
  guaranteedFloor Decimal       @db.Decimal(10,2)
  createdAt       DateTime      @default(now())
}

// ── Staff ────────────────────────────────────────────────────────────────

model StaffProfile {
  id         String           @id @default(cuid())
  userId     String           @unique
  user       User             @relation(fields: [userId], references: [id])
  clinicId   String
  isFullTime Boolean          @default(true)
  attendance Attendance[]
  commissions StaffCommission[]

  // ── HRMS: employment ──────────────────────────────────────────────────
  employeeId        String?           @unique  // e.g. EMP-0001
  employmentType    EmploymentType    @default(FULL_TIME)
  employmentStatus  EmploymentStatus  @default(PROBATION)
  joinDate          DateTime?
  confirmationDate  DateTime?         // end of probation
  resignationDate   DateTime?
  lastWorkingDate   DateTime?
  noticePeriodDays  Int?
  department        String?
  jobTitle          String?
  // Demographics
  dateOfBirth       DateTime?
  gender            String?           // "MALE" | "FEMALE" | "OTHER"
  phone             String?
  address           String?
  city              String?
  state             String?
  postcode          String?
  // Payroll
  basicSalary       Decimal?  @db.Decimal(10,2)
  bankName          String?
  bankAccountNo     String?
  epfNo             String?
  socsoNo           String?
  incomeTaxNo       String?
  // Emergency contact
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  // Documents
  icNo              String?
  passportNo        String?
  // HRMS relations
  leaveBalances     LeaveBalance[]
  leaveApplications LeaveApplication[]
  attendanceRecords AttendanceRecord[]
  claims            StaffClaim[]
  appraisals        Appraisal[]
  disciplinaries    Disciplinary[]
  trainings         StaffTraining[]
  kpis              StaffKpi[]
  schedules         StaffSchedule[]
  nurseOf           DentistNursePairing[] @relation("NursePairings")
  dentistOf         DentistNursePairing[] @relation("DentistPairings")
  coverRequests     LeaveCoverRequest[]   @relation("CoverRequested")
  coverOffers       LeaveCoverRequest[]   @relation("CoverOffered")
  paySlips          PaySlip[]
  documents         StaffDocument[]
  employmentHistory EmploymentHistory[]
  licenses          License[]
  headNurseOf       ClinicPayrollConfig[] @relation("ClinicHeadNurse")
}

model Attendance {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id])
  month          String       // "2026-05"
  totalWorkDays  Int
  attendedDays   Decimal      @db.Decimal(4,1)
  mcDays         Decimal      @default(0) @db.Decimal(3,1)
  elDays         Decimal      @default(0) @db.Decimal(3,1)
  unpaidDays     Decimal      @default(0) @db.Decimal(3,1)
  timeSlipDays   Decimal      @default(0) @db.Decimal(3,1)
  alDays         Decimal      @default(0) @db.Decimal(3,1)
  lateCount      Int          @default(0)
  @@unique([staffProfileId, month])
}

// ── Commission Config ────────────────────────────────────────────────────

enum CommissionMethod {
  INDIVIDUAL
  POOL_DIVIDE
}

enum TierType {
  PROGRESSIVE
  FLAT
}

model CommissionConfig {
  id               String           @id @default(cuid())
  clinicId         String
  clinic           Clinic           @relation(fields: [clinicId], references: [id])
  method           CommissionMethod  @default(INDIVIDUAL)
  tierType         TierType         @default(PROGRESSIVE)
  forfeitThreshold Int              @default(5)
  tiers            CommissionTier[]
  effectiveFrom    DateTime         @default(now())
}

model CommissionTier {
  id          String           @id @default(cuid())
  configId    String
  config      CommissionConfig @relation(fields: [configId], references: [id])
  roleTarget  String?
  tierOrder   Int
  floorAmount Decimal          @db.Decimal(10,2)
  ceilAmount  Decimal?         @db.Decimal(10,2)
  rate        Decimal          @db.Decimal(5,2)
}

// ── Patients ────────────────────────────────────────────────────────────

enum PatientStatus {
  PENDING   // self-registered via intake form, awaiting staff confirmation
  ACTIVE
  REJECTED
}

enum ReferralType {
  PATIENT          // existing patient in system
  INTERNAL_DOCTOR  // doctor already in ERP
  INTERNAL_CLINIC  // clinic already in ERP
  EXTERNAL         // free text — anyone not in system
}

model Patient {
  id           String   @id @default(cuid())
  patientRef   String   @unique
  name         String
  icNumber     String?
  passportNo   String?
  isForeigner  Boolean  @default(false)
  homeClinicId String
  homeClinic   Clinic   @relation(fields: [homeClinicId], references: [id])
  phone        String?
  email        String?

  // Demographics
  dateOfBirth  DateTime?
  gender       String?   // "MALE" | "FEMALE" | "OTHER"

  // Address
  address      String?
  city         String?
  state        String?
  postcode     String?

  // Registration status
  status       PatientStatus @default(ACTIVE)
  medicalNotes String?

  // Source tracking
  sourceId     String?
  source       PatientSource? @relation(fields: [sourceId], references: [id])

  // Referral (four types)
  referralType          ReferralType?
  referredByPatientId   String?
  referredByPatient     Patient?  @relation("PatientReferrals", fields: [referredByPatientId], references: [id])
  referrals             Patient[] @relation("PatientReferrals")
  referredByDoctorId    String?
  referredByDoctor      User?     @relation("DoctorReferrals", fields: [referredByDoctorId], references: [id])
  referredByClinicId    String?
  referredByClinic      Clinic?   @relation("ClinicReferrals", fields: [referredByClinicId], references: [id])
  externalReferrerName  String?
  externalReferrerType  String?   // "doctor" | "clinic" | "person"
  externalReferrerPhone String?
  externalReferrerEmail String?

  visits        Visit[]
  appointments  Appointment[]
  toothRecords  ToothRecord[]
  mcs           MedicalCertificate[]
  referralCommissions ReferralCommission[]
  deposits      PatientDeposit[]
  salesReturns  SalesReturn[]
  consentRequests ConsentRequest[]
  treatmentPlans  TreatmentPlan[]
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  deletedBy     String?
  deletedReason String?
  deletedByUser User?     @relation("PatientDeletedBy", fields: [deletedBy], references: [id])
  @@index([deletedAt])
  @@index([status])
  @@index([sourceId])
  @@index([referralType])
  @@index([referredByDoctorId])
  @@index([referredByClinicId])
  @@index([referredByPatientId])
}

model PatientSource {
  id          String    @id @default(cuid())
  name        String    // e.g. "Walk-in", "Google Ads", "Referral"
  description String?
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  patients    Patient[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([isActive])
}

// ── Patient Deposit / Wallet ──────────────────────────────────────────────

model PatientDeposit {
  id                String       @id @default(cuid())
  depositRef        String       @unique  // DEP-202506-001
  patientId         String
  patient           Patient      @relation(fields: [patientId], references: [id])
  clinicId          String
  clinic            Clinic       @relation(fields: [clinicId], references: [id])
  amount            Decimal      @db.Decimal(10,2)
  type              String       // "TOPUP" | "UTILIZATION" | "REFUND"
  paymentMethod     String?      // for TOPUP: CASH_CURRENT | CASH_NEXT | CREDIT_CARD | FPX | EWALLET | ATOME
  // Refund fields
  refundCategory    String?      // "TREATMENT_FAILURE" | "PATIENT_REQUEST" | "OVERPAYMENT" | "OTHER"
  reason            String?      // required for REFUND — describe reason
  salesReturnId     String?      @unique
  salesReturn       SalesReturn? @relation(fields: [salesReturnId], references: [id])
  // Utilization / visit links
  invoiceId         String?      // set when type = UTILIZATION
  invoice           Invoice?     @relation("DepositUtilizationInvoice", fields: [invoiceId], references: [id])
  visitId           String?
  notes             String?
  createdById       String?
  createdBy         User?        @relation("DepositCreator", fields: [createdById], references: [id])
  createdAt         DateTime     @default(now())
  @@index([patientId])
  @@index([clinicId])
}

// ── Sales Returns (treatment failure revenue reversal) ────────────────────

model SalesReturn {
  id                String    @id @default(cuid())
  returnRef         String    @unique  // RTN-202506-001
  clinicId          String
  clinic            Clinic    @relation(fields: [clinicId], references: [id])
  patientId         String
  patient           Patient   @relation(fields: [patientId], references: [id])
  originalInvoiceId String
  originalInvoice   Invoice   @relation("SalesReturnOriginalInvoice", fields: [originalInvoiceId], references: [id])
  amount            Decimal   @db.Decimal(10,2)
  reason            String    // detailed description of treatment failure
  returnDate        DateTime  @default(now())
  // Back-link to the deposit refund that triggered this return
  depositRefund     PatientDeposit?
  createdById       String?
  createdBy         User?     @relation("SalesReturnCreator", fields: [createdById], references: [id])
  createdAt         DateTime  @default(now())
  @@index([clinicId])
  @@index([patientId])
  @@index([originalInvoiceId])
}

model TreatmentType {
  id            String                @id @default(cuid())
  code          String                @unique
  name          String
  defaultPrice  Decimal               @db.Decimal(10,2)
  sstApplicable Boolean               @default(false)
  treatments     Treatment[]
  doctorRates    DoctorTreatmentRate[]
  stageTemplates TreatmentStageTemplate[]
}

model Visit {
  id             String       @id @default(cuid())
  visitRef       String       @unique
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id])
  visitDate      DateTime
  chiefComplaint String?
  remarks        String?
  treatments     Treatment[]
  invoices       Invoice[]
  labJobs        LabJob[]
  toothRecords    ToothRecord[]
  appointment     Appointment?
  treatmentStages TreatmentStage[]
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  deletedBy       String?
  deletedByUser   User?     @relation("VisitDeletedBy", fields: [deletedBy], references: [id])
  @@index([clinicId, visitDate])
  @@index([patientId])
  @@index([deletedAt])
}

model Treatment {
  id              String            @id @default(cuid())
  visitId         String
  visit           Visit             @relation(fields: [visitId], references: [id])
  treatmentTypeId String
  treatmentType   TreatmentType     @relation(fields: [treatmentTypeId], references: [id])
  doctorId        String?
  doctor          DoctorProfile?    @relation(fields: [doctorId], references: [id])
  billedAmount    Decimal           @db.Decimal(10,2)
  collectedAmount Decimal           @default(0) @db.Decimal(10,2)
  doctorSplit     Decimal           @default(100) @db.Decimal(5,2)
  labFee          Decimal           @default(0) @db.Decimal(10,2)
  sst             Decimal           @default(0) @db.Decimal(10,2)
  labJobId        String?
  labJob          LabJob?           @relation(fields: [labJobId], references: [id])
  commissions     DoctorCommission[]
  locumPayoutLines LocumPayoutLine[]
  createdAt       DateTime          @default(now())
  @@index([visitId])
  @@index([doctorId])
}

// ── Lab ──────────────────────────────────────────────────────────────────

enum LabJobStatus {
  ORDERED
  SENT_TO_LAB
  RECEIVED
  FITTED
}

model LabJob {
  id              String       @id @default(cuid())
  labJobRef       String       @unique
  visitId         String
  visit           Visit        @relation(fields: [visitId], references: [id])
  // Vendor is optional at creation — the doctor assigns the right lab after
  // assessing the case (Lab section → job → assign vendor)
  vendorId        String?
  vendor          LabVendor?   @relation(fields: [vendorId], references: [id])
  clinicId        String
  clinic          Clinic       @relation("LabJobClinic", fields: [clinicId], references: [id])
  status          LabJobStatus @default(ORDERED)
  workDescription String?
  estimatedFee    Decimal      @db.Decimal(10,2)
  sentDate        DateTime?
  expectedDate    DateTime?
  receivedDate    DateTime?
  fittedDate      DateTime?
  invoiceDate     DateTime?
  invoiceNumber   String?
  invoiceAmount   Decimal?     @db.Decimal(10,2)
  paidToVendor    Boolean      @default(false)
  paidDate        DateTime?
  notes           String?
  treatments       Treatment[]
  supplierInvoices SupplierInvoice[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
